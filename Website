<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Projects &amp; Repos — Ravi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0b0e17;
    --bg-2: #141a2c;
    --paper: #f6f4ff;
    --ink: #1c1233;
    --violet: #8b5cf6;
    --violet-deep: #5b32b8;
    --cyan: #22d3ee;
    --amber: #fbbf24;
    --muted: #8b93b0;
    --line: rgba(246,244,255,0.14);
  }
  *{box-sizing:border-box;}
  html{ scroll-behavior:smooth; }
  body{
    margin:0;
    position:relative;
    overflow-x:hidden;
    background:
      radial-gradient(circle at 12% 6%, rgba(139,92,246,0.20), transparent 42%),
      radial-gradient(circle at 88% 14%, rgba(34,211,238,0.14), transparent 40%),
      radial-gradient(circle at 80% 95%, rgba(251,191,36,0.10), transparent 42%),
      var(--bg);
    color:var(--paper);
    font-family:'Space Mono', monospace;
    font-weight:700;
    min-height:100vh;
  }
  .scanline{
    position:fixed; inset:0; pointer-events:none; z-index:1;
    background:repeating-linear-gradient(to bottom, rgba(0,0,0,0.05) 0px, rgba(0,0,0,0.05) 1px, transparent 1px, transparent 3px);
    opacity:0.28;
  }
  .bubbles{
    position:fixed; inset:0; overflow:hidden; pointer-events:none; z-index:0;
  }
  .bubble{
    position:absolute;
    bottom:-120px;
    border-radius:50%;
    background:radial-gradient(circle at 32% 28%, rgba(255,255,255,0.55), rgba(139,92,246,0.18) 55%, rgba(34,211,238,0.05) 78%);
    border:1px solid rgba(139,92,246,0.28);
    animation-name:rise;
    animation-timing-function:linear;
    animation-iteration-count:infinite;
  }
  @keyframes rise{
    0%{ transform:translateY(0) translateX(0); opacity:0; }
    8%{ opacity:0.8; }
    92%{ opacity:0.55; }
    100%{ transform:translateY(-115vh) translateX(var(--drift, 40px)); opacity:0; }
  }
  header, .wrap, .topnav{ position:relative; z-index:2; }

  .topnav{
    position:sticky; top:0; z-index:20;
    display:flex; justify-content:center; gap:10px; flex-wrap:wrap;
    padding:16px 20px;
    background:rgba(11,14,23,0.85);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .navbtn{
    font-family:'Space Mono', monospace;
    font-weight:700;
    font-size:11px;
    letter-spacing:1px;
    color:var(--paper);
    text-decoration:none;
    padding:10px 16px;
    border:1px solid var(--line);
    border-radius:6px;
    background:rgba(255,255,255,0.03);
    cursor:pointer;
    transition:border-color .15s ease, color .15s ease, transform .1s ease;
  }
  .navbtn:hover{ border-color:var(--cyan); color:var(--cyan); transform:translateY(-2px); }
  .navbtn:nth-child(2):hover{ border-color:var(--violet); color:var(--violet); }
  .navbtn:nth-child(3):hover{ border-color:var(--amber); color:var(--amber); }

  header{
    padding:56px 24px 36px;
    text-align:center;
    border-bottom:1px dashed var(--line);
  }
  .kicker{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-family:'Press Start 2P', monospace;
    font-size:10px;
    color:var(--cyan);
    letter-spacing:3px;
    margin-bottom:22px;
  }
  .kicker::before, .kicker::after{
    content:'';
    width:22px; height:2px;
    background:linear-gradient(90deg, transparent, var(--cyan));
  }
  .kicker::after{ background:linear-gradient(90deg, var(--cyan), transparent); }
  h1{
    font-family:'Press Start 2P', monospace;
    font-size:clamp(22px, 4.6vw, 38px);
    line-height:1.7;
    letter-spacing:1px;
    margin:0 0 18px;
    background:linear-gradient(100deg, var(--violet) 0%, var(--cyan) 55%, var(--amber) 100%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    filter:drop-shadow(0 3px 0 rgba(0,0,0,0.4));
  }
  .underline{
    width:120px; height:3px; margin:0 auto 22px;
    background:linear-gradient(90deg, var(--violet), var(--cyan), var(--amber));
    border-radius:2px;
  }
  header p{
    color:var(--muted);
    max-width:480px;
    margin:0 auto;
    font-size:13px;
    letter-spacing:0.5px;
    line-height:1.7;
  }
  .by{
    display:block;
    font-family:'Space Mono', monospace;
    font-size:12px;
    color:var(--amber);
    margin-top:4px;
    letter-spacing:3px;
  }
  .wrap{
    max-width:1080px;
    margin:0 auto;
    padding:44px 24px 40px;
  }
  .section{ scroll-margin-top:80px; padding:36px 0; }
  .section + .section{ border-top:1px dashed var(--line); }
  .section-head{
    display:flex; align-items:baseline; gap:14px;
    margin-bottom:26px;
  }
  .section-title{
    font-family:'Press Start 2P', monospace;
    font-size:15px;
    letter-spacing:1px;
    margin:0;
    color:var(--paper);
  }
  .section-count{
    font-size:11px;
    color:var(--muted);
    letter-spacing:1px;
  }
  #games .section-title{ color:var(--cyan); }
  #projects .section-title{ color:var(--violet); }
  #profile .section-title{ color:var(--amber); }

  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(230px, 1fr));
    gap:26px;
  }
  .slot{ perspective:1400px; height:280px; filter:drop-shadow(0 10px 20px rgba(0,0,0,0.45)); }
  .card{
    position:relative;
    width:100%; height:100%;
    transform-style:preserve-3d;
    -webkit-transform-style:preserve-3d;
    transition:transform .55s cubic-bezier(.22,.85,.25,1);
    cursor:pointer;
  }
  .slot:hover .card{ transform:translateY(-4px); }
  .slot.flipped .card{ transform:rotateY(180deg) translateY(-4px); }
  .face{
    position:absolute; inset:0;
    backface-visibility:hidden;
    -webkit-backface-visibility:hidden;
    transform:translateZ(0);
    -webkit-transform:translateZ(0);
    border-radius:10px;
    display:flex; flex-direction:column;
    padding:0;
    overflow:hidden;
  }
  .front{
    background:linear-gradient(155deg, #fbfaff 0%, var(--paper) 45%, #e2ddfb 100%);
    color:var(--ink);
    border:1px solid rgba(28,18,51,0.12);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.9),
      inset 0 -18px 26px -18px rgba(28,18,51,0.18);
    justify-content:space-between;
  }
  .front::before{
    content:'';
    position:absolute; top:0; left:14%; right:14%; height:16px;
    background:var(--bg-2);
    border-radius:0 0 8px 8px;
  }
  .front .shell{
    position:relative;
    flex:1;
    display:flex; flex-direction:column; justify-content:space-between;
    padding:30px 18px 18px;
  }
  .front .label{
    background:var(--face-color, var(--violet));
    border-radius:6px;
    padding:14px 14px 16px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,0.35), inset 0 -6px 10px -4px rgba(0,0,0,0.25);
  }
  .front .tag{
    font-family:'Press Start 2P', monospace;
    font-size:8px;
    color:rgba(255,255,255,0.85);
    letter-spacing:1.5px;
  }
  .front .title{
    font-family:'Press Start 2P', monospace;
    font-size:13px;
    line-height:1.8;
    margin:10px 0 0;
    color:#ffffff;
    word-break:break-word;
  }
  .front .hint{
    font-size:10px;
    color:var(--muted);
    letter-spacing:1.5px;
    text-align:center;
    margin-top:14px;
  }
  .front .screw{
    position:absolute;
    width:9px; height:9px;
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #fff, #c8c2e0 60%, #9088ab 100%);
    box-shadow:inset 0 0 0 1px rgba(28,18,51,0.25);
  }
  .front .screw.tl{ top:24px; left:14px; }
  .front .screw.tr{ top:24px; right:14px; }
  .front .screw.bl{ bottom:14px; left:14px; }
  .front .screw.br{ bottom:14px; right:14px; }
  .back{
    background:linear-gradient(160deg, var(--bg-2) 0%, #0a0e1c 100%);
    border:1px solid var(--face-color, var(--violet));
    box-shadow:inset 0 0 0 1px rgba(139,92,246,0.08), inset 0 20px 30px -24px rgba(139,92,246,0.35);
    transform:rotateY(180deg);
    -webkit-transform:rotateY(180deg);
    justify-content:space-between;
    padding:20px;
  }
  .back .desc{
    font-size:12px;
    font-weight:400;
    letter-spacing:0.2px;
    line-height:1.8;
    color:var(--paper);
    overflow-y:auto;
    max-height:150px;
  }
  .back .desc.empty{ color:var(--muted); font-style:italic; }
  .back .actions{
    display:flex; flex-direction:column; gap:8px;
  }
  .launch{
    display:block;
    text-align:center;
    font-family:'Press Start 2P', monospace;
    font-size:10px;
    letter-spacing:1px;
    background:var(--face-color, var(--violet));
    color:#04070f;
    text-decoration:none;
    padding:13px;
    border-radius:5px;
    box-shadow:0 4px 0 rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.4);
    transition:transform .1s ease, box-shadow .1s ease;
  }
  .launch:hover{ transform:translateY(-2px); box-shadow:0 6px 0 rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.4); }
  .launch:active{ transform:translateY(1px); box-shadow:0 2px 0 rgba(0,0,0,0.35); }

  .empty-state{
    grid-column:1/-1;
    text-align:center;
    padding:50px 20px;
    border:1px dashed var(--line);
    border-radius:10px;
    color:var(--muted);
    font-size:13px;
    letter-spacing:0.5px;
  }

  .profile-layout{
    display:flex; gap:24px; flex-wrap:wrap; align-items:stretch;
  }
  .photo-card{
    position:relative;
    width:220px; flex-shrink:0;
    aspect-ratio:3/4;
    border-radius:14px;
    overflow:hidden;
    border:1px solid var(--line);
    box-shadow:0 14px 28px rgba(0,0,0,0.45), inset 0 0 0 1px rgba(139,92,246,0.15);
  }
  .photo-img{
    width:100%; height:100%; object-fit:cover; display:block;
  }
  .photo-tag{
    position:absolute; left:0; right:0; bottom:0;
    background:linear-gradient(0deg, rgba(11,14,23,0.92), transparent);
    color:var(--paper);
    font-family:'Press Start 2P', monospace;
    font-size:8px; letter-spacing:1px;
    text-align:center;
    line-height:1.6;
    padding:20px 6px 12px;
  }
  .profile-card{
    flex:1; min-width:240px;
    display:flex; gap:24px; align-items:center; flex-wrap:wrap;
    background:linear-gradient(155deg, rgba(251,191,36,0.08), rgba(255,255,255,0.02));
    border:1px solid var(--line);
    border-radius:14px;
    padding:28px;
  }
  .avatar{
    width:76px; height:76px; border-radius:50%;
    background:linear-gradient(140deg, var(--violet), var(--cyan));
    display:flex; align-items:center; justify-content:center;
    font-family:'Press Start 2P', monospace;
    font-size:20px; color:var(--bg); flex-shrink:0;
  }
  .profile-info{ flex:1; min-width:200px; }
  .profile-info h3{
    font-family:'Press Start 2P', monospace;
    font-size:14px; letter-spacing:1px; margin:0 0 10px; color:var(--amber);
  }
  .profile-info p{
    font-size:13px; font-weight:400; line-height:1.8; color:var(--muted); margin:0 0 14px;
    letter-spacing:0.3px; max-width:520px;
  }
  .profile-links{ display:flex; gap:10px; flex-wrap:wrap; }
  .profile-links a{
    display:inline-flex; align-items:center; gap:8px;
    font-size:11px; letter-spacing:1px; color:var(--paper);
    text-decoration:none; border:1px solid var(--line); padding:8px 12px 8px 8px; border-radius:6px;
    transition:border-color .15s ease;
  }
  .profile-links a:hover{ border-color:var(--amber); }
  .at-badge{
    display:inline-flex; align-items:center; justify-content:center;
    width:20px; height:20px; border-radius:5px;
    font-family:'Press Start 2P', monospace;
    font-size:11px;
    color:var(--bg);
    background:linear-gradient(140deg, var(--violet), var(--cyan) 55%, var(--amber));
  }

  .sr-only{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }

  @media (max-width:1024px){
    .grid{ grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:20px; }
    .wrap{ padding:36px 20px 20px; }
    header{ padding:48px 20px 28px; }
  }
  @media (max-width:480px){
    .slot{ height:260px; }
    .grid{ grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); gap:16px; }
    .profile-card{ flex-direction:column; text-align:center; }
  }
</style>
</head>
<body>
<div class="bubbles" id="bubbles"></div>
<div class="scanline"></div>
<h1 class="sr-only">A shelf of flip-cards linking to Ravi's GitHub games and projects, plus a profile section</h1>

<nav class="topnav">
  <button class="navbtn" type="button" data-target="games">Games by Ravi</button>
  <button class="navbtn" type="button" data-target="projects">Projects by Ravi</button>
  <button class="navbtn" type="button" data-target="profile">Kr. Ravi Raj profile</button>
</nav>

<header>
  <div class="kicker">SYSTEM READY</div>
  <h1>PROJECTS &amp; REPOS</h1>
  <div class="underline"></div>
  <span class="by">BY RAVI</span>
  <p>Click a cartridge to flip it over and launch.</p>
</header>

<div class="wrap">
  <section id="games" class="section">
    <div class="section-head">
      <h2 class="section-title">Games by Ravi</h2>
      <span class="section-count" id="gamesCount"></span>
    </div>
    <div class="grid" id="gamesGrid"></div>
  </section>

  <section id="projects" class="section">
    <div class="section-head">
      <h2 class="section-title">Projects by Ravi</h2>
      <span class="section-count" id="projectsCount"></span>
    </div>
    <div class="grid" id="projectsGrid"></div>
  </section>

  <section id="profile" class="section">
    <div class="section-head">
      <h2 class="section-title">Kr. Ravi Raj profile</h2>
    </div>
    <div class="profile-layout">
      <div class="photo-card">
        <img src="data:image/jpeg;base64,
